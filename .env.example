# Refiloe Marketing - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ============================================
# Flask Configuration
# ============================================
FLASK_ENV=production
FLASK_APP=app.py
SECRET_KEY=your-secret-key-here

# ============================================
# Supabase Configuration
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-key-here

# ============================================
# HeyGen API Configuration
# ============================================
HEYGEN_API_KEY=your-heygen-api-key-here

# Single avatar group ID - all avatar looks are generated dynamically using LooksGenerator
HEYGEN_AVATAR_GROUP=your-heygen-avatar-group-id-here

# HeyGen Voice IDs
HEYGEN_DEFAULT_VOICE_ID=1bd001e7e50f421d891986aad5158bc8
HEYGEN_EDUCATIONAL_VOICE_ID=your-educational-voice-id
HEYGEN_MOTIVATIONAL_VOICE_ID=your-motivational-voice-id
HEYGEN_TIPS_VOICE_ID=your-tips-voice-id

# HeyGen Usage Limits
HEYGEN_MONTHLY_LIMIT=120
HEYGEN_POLL_TIMEOUT=420

# HeyGen Database Tables
HEYGEN_USAGE_TABLE=video_generation_usage
HEYGEN_VIDEO_TABLE=generated_videos
HEYGEN_VIDEO_ANALYTICS_TABLE=video_analytics

# ============================================
# Facebook Integration
# ============================================
FACEBOOK_ACCESS_TOKEN=your-facebook-access-token
FACEBOOK_PAGE_ID=your-facebook-page-id

# ============================================
# Social Media Automation
# ============================================
ENABLE_SOCIAL_MEDIA=true

# ============================================
# OpenAI Configuration (if used)
# ============================================
OPENAI_API_KEY=your-openai-api-key-here

# ============================================
# WhatsApp Notifications (Meta Cloud API)
# ============================================
# WhatsApp Business Phone Number ID from Meta Developer Portal
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# Permanent access token from Meta Developer Portal
WHATSAPP_API_TOKEN=your-api-token

# API URL (optional - will be constructed from PHONE_NUMBER_ID if not provided)
WHATSAPP_API_URL=https://graph.facebook.com/v18.0/{PHONE_NUMBER_ID}/messages

# Phone number to receive notifications (include country code, e.g., 27XXXXXXXXX for South Africa)
NOTIFICATION_PHONE_NUMBER=27XXXXXXXXX

# Enable/disable WhatsApp notifications
ENABLE_WHATSAPP_NOTIFICATIONS=false

# Dashboard URL for report links
DASHBOARD_URL=https://your-dashboard-url.com
